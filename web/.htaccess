RewriteEngine On
ErrorDocument 404 /404.html

# https a www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.stolarstvikubis.cz/$1 [R=301,L]

# staré adresy z Webnode -> nové stránky
